# Optional: Gemini API for richer scripts (free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# YouTube OAuth — required for automatic upload
# https://console.cloud.google.com/ → YouTube Data API v3 → OAuth Desktop credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# public | unlisted | private
YOUTUBE_PRIVACY=public

# Channel branding
CHANNEL_NAME=Learning Adventures for Kids
DEFAULT_VOICE=en-US-AnaNeural

# Daily schedule (cron format) — used by npm start
CRON_SCHEDULE=0 9 * * *
TIMEZONE=America/New_York

# Run today's job immediately when npm start is launched
RUN_ON_START=true

# Skip if today's video was already uploaded (set false to force re-upload)
SKIP_IF_UPLOADED=true

# Upload retry attempts on failure
UPLOAD_RETRIES=3

# Web app port (npm run app)
DASHBOARD_PORT=3847

# Visual engine:
#   cartoon2d = 2D preschool cartoon show (recommended — Super Simple Songs style)
#   show      = low-poly 3D worlds (toy-like)
#   talking   = 3D character over AI backgrounds
#   ai        = AI stills + Ken Burns
#   threed    = basic Three.js
#   auto      = cartoon2d → ai → threed fallbacks
VISUAL_ENGINE=cartoon2d

# Optional free AI video credits — https://enter.pollinations.ai (no credit card)
# Enables text-to-video when Pollen grants are available; otherwise AI still images + motion
POLLINATIONS_API_KEY=
