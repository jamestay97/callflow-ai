# Server — API runs on 3001, dashboard on 3000
PORT=3001
WEB_APP_URL=http://localhost:3000
NODE_ENV=development

# Production — required when NODE_ENV=production
# PUBLIC_BASE_URL=https://your-api.railway.app
# WEB_APP_URL=https://your-app.vercel.app
# ADMIN_API_KEY=generate-a-long-random-secret
# VAPI_WEBHOOK_SECRET=same-secret-as-vapi-assistant
# TRUST_PROXY=true
# CORS_ORIGINS=https://your-app.vercel.app
# TENANT_DATA_PATH=/app/data/tenants.json
# BOOKINGS_DATA_PATH=/app/data/bookings.json
# Voice AI — CallSphere or Vapi (set VOICE_ENGINE to "callsphere" | "vapi")
VOICE_ENGINE=vapi
CALLSPHERE_API_KEY=
CALLSPHERE_WEBHOOK_SECRET=
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Cal.com — https://app.cal.com/settings/developer
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_BASE_URL=https://api.cal.com/v2

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Make.com — post-call + payment SMS automations
MAKE_WEBHOOK_URL=

# Business context (injected into the AI system prompt)
BUSINESS_NAME=Acme Home Services
BUSINESS_PHONE=+15551234567
BUSINESS_TIMEZONE=America/New_York
BUSINESS_WEBSITE=https://example.com
