{
  "name": "ai-receptionist",
  "version": "0.1.0",
  "description": "Backend service for AI receptionist — voice webhooks, Cal.com scheduling, Stripe payment links",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm run dev --prefix web",
    "dev:all": "npx concurrently -n api,web -c blue,green \"npm run dev\" \"npm run dev:web\"",
    "build": "tsc",
    "build:web": "npm run build --prefix web",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build"
  },
  "keywords": [
    "ai-receptionist",
    "vapi",
    "cal.com",
    "stripe"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "stripe": "^17.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
